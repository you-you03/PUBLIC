{
  "manifest_version": 3,
  "name": "URLをMarkdownにするぞ君",
  "version": "0.1.0",
  "description": "開いているWebページをMarkdownに変換して保存します。",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
